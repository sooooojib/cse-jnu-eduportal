rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── AUTHENTICATION & RBAC HELPERS ───────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isRole(targetRole) {
      return isAuthenticated() && (
        ('role' in request.auth.token && (
          request.auth.token.role == targetRole ||
          request.auth.token.role == targetRole.lower() ||
          request.auth.token.role == targetRole.upper()
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && (
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == targetRole ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == targetRole.lower() ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == targetRole.upper()
         ))
      );
    }

    function isAdmin() {
      return isRole('ADMIN') || isRole('admin');
    }

    function isTeacher() {
      return isRole('TEACHER') || isRole('teacher') || isRole('FACULTY') || isRole('faculty') || isAdmin();
    }

    function isCR() {
      return isRole('CR') || isRole('cr') ||
        (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'isCR' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCR == true);
    }

    function isStudent() {
      return isRole('STUDENT') || isRole('student') || isCR();
    }

    // ─── VALIDATION HELPERS ──────────────────────────────────────────────────
    function isNonEmptyString(field, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() > 0 &&
             request.resource.data[field].size() <= maxLen;
    }

    // ─── COLLECTION: users ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'year', 'semester', 'studentId', 'email'])
      );
    }

    // ─── COLLECTION: signupRequests ──────────────────────────────────────────
    match /signupRequests/{requestId} {
      allow create: if request.resource.data.status == 'PENDING' &&
                       isNonEmptyString('email', 100) &&
                       isNonEmptyString('fullName', 100);
      allow read, update, delete: if isAdmin();
    }

    // ─── COLLECTION: courses ─────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── COLLECTION: courseAssignments ───────────────────────────────────────
    match /courseAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── COLLECTION: enrollments ─────────────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── COLLECTION: schedules ───────────────────────────────────────────────
    match /schedules/{slotId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isCR() || isTeacher() ||
        (isAuthenticated() && (
          request.resource.data.creatorRole == 'CR' ||
          request.resource.data.createdByCrId == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid ||
          (resource != null && (
            resource.data.createdByCrId == request.auth.uid ||
            resource.data.createdBy == request.auth.uid
          ))
        ));
      allow delete: if isAdmin() || isCR() || isTeacher() ||
        (isAuthenticated() && resource != null && (
          resource.data.createdByCrId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        ));
    }
    match /scheduleSlots/{slotId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isCR() || isTeacher() ||
        (isAuthenticated() && (
          request.resource.data.creatorRole == 'CR' ||
          request.resource.data.createdByCrId == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid ||
          (resource != null && (
            resource.data.createdByCrId == request.auth.uid ||
            resource.data.createdBy == request.auth.uid
          ))
        ));
      allow delete: if isAdmin() || isCR() || isTeacher() ||
        (isAuthenticated() && resource != null && (
          resource.data.createdByCrId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        ));
    }

    // ─── COLLECTION: exams ───────────────────────────────────────────────────
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isTeacher() || isCR();
    }

    // ─── COLLECTION: attendanceSessions ──────────────────────────────────────
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() || (isAuthenticated() && request.resource.data.teacherId == request.auth.uid);
      allow update: if isTeacher() || (isAuthenticated() && (resource.data.teacherId == request.auth.uid || request.resource.data.isActive == false));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.teacherId == request.auth.uid);
    }

    // ─── COLLECTION: attendance ──────────────────────────────────────────────
    match /attendance/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher() ||
        (isAuthenticated() && (
          (request.resource.data.studentId == request.auth.uid && request.resource.data.status == 'PRESENT') ||
          (resource != null && resource.data.studentId == request.auth.uid)
        ));
      allow delete: if isAdmin() || isTeacher();
    }

    // ─── COLLECTION: counselingSlots ─────────────────────────────────────────
    match /counselingSlots/{slotId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher() || (isAuthenticated() && request.resource.data.teacherId == request.auth.uid) || isAdmin();
    }

    // ─── COLLECTION: counselingBookings ──────────────────────────────────────
    match /counselingBookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.studentId == request.auth.uid;
      allow update: if isUser(resource.data.studentId) || isTeacher() || isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.teacherId == request.auth.uid);
    }

    // ─── COLLECTION: feedback ────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)) &&
         get(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)).data.studentId == request.auth.uid)
      );
      allow create: if isAuthenticated() &&
                       (request.resource.data.studentId == request.auth.uid ||
                        (request.resource.data.studentId == 'ANONYMOUS' && request.resource.data.isAnonymous == true)) &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.comments.size() >= 5;
      allow update: if isAuthenticated() && (
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        (resource.data.studentId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)) &&
         get(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)).data.studentId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (
        exists(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)) &&
        get(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)).data.studentId == request.auth.uid
      );
    }

    // ─── COLLECTION: feedbackIdentities (ADMIN & STUDENT AUTHOR ONLY) ────────
    // Strictly isolates real student identity for anonymous feedback.
    // Teachers have ZERO read or write access to this collection.
    match /feedbackIdentities/{feedbackId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
                       request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (
        resource.data.studentId == request.auth.uid
      );
    }


    // ─── COLLECTION: semesterUpgradeRequests ─────────────────────────────────
    match /semesterUpgradeRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAdmin()
      );
      allow create: if isStudent() &&
                       request.resource.data.studentId == request.auth.uid &&
                       request.resource.data.status == 'PENDING';
      allow update, delete: if isAdmin();
    }

    // ─── COLLECTION: notifications ───────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'ALL' ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']))
      );
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── COLLECTION: notices ─────────────────────────────────────────────────
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── COLLECTION: public_routines ─────────────────────────────────────────
    match /public_routines/{routineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── COLLECTION: communicationLogs ───────────────────────────────────────
    match /communicationLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server-side Cloud Functions only
    }
  }
}
