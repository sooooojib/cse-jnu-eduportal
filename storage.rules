rules_version = '2';
// S1-11: roles come from the Firestore users record (login-token roles are
// never set in this project), only approved active members can touch files,
// and counseling / feedback files are limited to the people involved.
//
// Note: files are normally shown through their download URL (which carries its
// own access token). These rules guard SDK access: listing, reading by path,
// uploading and deleting.
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Who is asking (read from Firestore, like firestore.rules) ─────────────
    function userDoc(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }

    function isMember() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        userDoc(request.auth.uid).data.get('isActive', true) != false;
    }

    function myRole() {
      return string(userDoc(request.auth.uid).data.get('role', '')).upper();
    }

    function isAdmin() {
      return isMember() && myRole() in ['ADMIN', 'CHAIRMAN'];
    }

    function isTeacher() {
      return isMember() && myRole() in ['TEACHER', 'FACULTY', 'ADMIN', 'CHAIRMAN'];
    }

    function isStudent() {
      return isMember() && (myRole() in ['STUDENT', 'CR'] ||
        userDoc(request.auth.uid).data.get('isCR', false) == true);
    }

    // ─── Upload checks ─────────────────────────────────────────────────────────
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)') &&
             request.resource.size <= 5 * 1024 * 1024;
    }

    function isValidDocument() {
      return (
        request.resource.contentType.matches('image/(jpeg|png|webp)') ||
        request.resource.contentType == 'application/pdf' ||
        request.resource.contentType == 'text/plain' ||
        request.resource.contentType == 'application/msword' ||
        request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      ) && request.resource.size <= 10 * 1024 * 1024;
    }

    function uploadedByMe() {
      return request.resource.metadata != null &&
             request.resource.metadata.get('uploadedBy', '') == request.auth.uid;
    }

    function iUploaded() {
      return request.auth != null && resource.metadata != null &&
             resource.metadata.get('uploadedBy', '') == request.auth.uid;
    }

    // ─── 1. NOTICE ATTACHMENTS: admins / chairman upload, members read ──────────
    match /notices/{noticeId}/{fileName} {
      allow read: if isMember();
      allow create, update: if isAdmin() && isValidDocument() && uploadedByMe();
      allow delete: if isAdmin();
    }

    // ─── 2. PROFILE PHOTOS: owner (or admin) uploads images; members read ───────
    match /avatars/{userId}/{fileName} {
      allow read: if isMember();
      allow create, update: if isMember() && (request.auth.uid == userId || isAdmin()) &&
                               isValidImage() && uploadedByMe();
      allow delete: if isMember() && (request.auth.uid == userId || isAdmin());
    }

    // ─── 3. FEEDBACK FILES FROM STUDENTS ────────────────────────────────────────
    // Uploaded while the feedback is still a draft, so they can't be tied to a
    // feedback record yet. Only the uploader (and admins) can read or delete
    // them by path; the teacher sees them through the saved download URL.
    match /feedback/{feedbackId}/attachments/{fileName} {
      allow read: if isAdmin() || (isMember() && iUploaded());
      allow create: if isStudent() && isValidDocument() && uploadedByMe();
      allow delete: if isAdmin() || (isMember() && iUploaded());
    }

    // ─── 4. TEACHER REPLY FILES: only the teacher the feedback is about ─────────
    match /feedback/{feedbackId}/replies/{fileName} {
      function feedback() {
        return firestore.get(/databases/(default)/documents/feedback/$(feedbackId)).data;
      }
      allow read: if isAdmin() || (isMember() && (
        iUploaded() ||
        feedback().get('teacherId', '') == request.auth.uid ||
        feedback().get('studentId', '') == request.auth.uid
      ));
      allow create: if isTeacher() && isValidDocument() && uploadedByMe() &&
                       (isAdmin() || feedback().get('teacherId', '') == request.auth.uid);
      allow delete: if isAdmin() || (isMember() && iUploaded());
    }

    // ─── 5. COUNSELING FILES: only that booking's student and teacher ───────────
    match /counseling/{bookingId}/{fileName} {
      function booking() {
        return firestore.get(/databases/(default)/documents/counselingBookings/$(bookingId)).data;
      }
      function inBooking() {
        return isMember() && request.auth.uid in [
          booking().get('studentId', ''), booking().get('teacherId', '')
        ];
      }
      allow read: if isAdmin() || inBooking();
      allow create: if inBooking() && isValidDocument() && uploadedByMe();
      allow delete: if isAdmin() || (inBooking() && iUploaded());
    }

    // ─── 6. EVERYTHING ELSE IS CLOSED ───────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
