# CSE JnU EduPortal Backend Environment Variables Template

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGIN=*

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cse_jnu_eduportal
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cse_jnu_eduportal
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# JWT Security Secrets (Generate secure random strings in production)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long_jnu
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long_jnu
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
