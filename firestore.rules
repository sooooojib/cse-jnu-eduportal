rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── AUTHENTICATION & RBAC HELPERS ───────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : null);
    }

    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isTeacher() {
      return hasRole('TEACHER') || isAdmin();
    }

    function isCR() {
      return hasRole('CR');
    }

    function isStudent() {
      return hasRole('STUDENT') || isCR();
    }

    // ─── VALIDATION HELPERS ──────────────────────────────────────────────────
    function isNonEmptyString(field, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() > 0 &&
             request.resource.data[field].size() <= maxLen;
    }

    // ─── COLLECTION: users ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'year', 'semester', 'studentId', 'email'])
      );
    }

    // ─── COLLECTION: signupRequests ──────────────────────────────────────────
    match /signupRequests/{requestId} {
      allow create: if request.resource.data.status == 'PENDING' &&
                       isNonEmptyString('email', 100) &&
                       isNonEmptyString('fullName', 100);
      allow read, update, delete: if isAdmin();
    }

    // ─── COLLECTION: courses ─────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── COLLECTION: courseAssignments ───────────────────────────────────────
    match /courseAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── COLLECTION: enrollments ─────────────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── COLLECTION: schedules ───────────────────────────────────────────────
    match /schedules/{slotId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isCR();
    }
    match /scheduleSlots/{slotId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isCR();
    }

    // ─── COLLECTION: exams ───────────────────────────────────────────────────
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // ─── COLLECTION: attendanceSessions ──────────────────────────────────────
    match /attendanceSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    // ─── COLLECTION: attendance ──────────────────────────────────────────────
    match /attendance/{recordId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isTeacher()
      );
      allow create: if isStudent() &&
                       request.resource.data.studentId == request.auth.uid &&
                       request.resource.data.status == 'PRESENT';
      allow update: if isTeacher();
      allow delete: if isAdmin();
    }

    // ─── COLLECTION: counselingSlots ─────────────────────────────────────────
    match /counselingSlots/{slotId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isTeacher() && (
        request.resource.data.teacherId == request.auth.uid || isAdmin()
      );
    }

    // ─── COLLECTION: counselingBookings ──────────────────────────────────────
    match /counselingBookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isStudent() &&
                       request.resource.data.studentId == request.auth.uid &&
                       request.resource.data.status == 'PENDING';
      allow update: if isUser(resource.data.studentId) || isTeacher();
      allow delete: if isAdmin();
    }

    // ─── COLLECTION: feedback ────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)) &&
         get(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)).data.studentId == request.auth.uid)
      );
      allow create: if isStudent() &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.comments.size() >= 5;
      allow update: if isAuthenticated() && (
        (isTeacher() && resource.data.teacherId == request.auth.uid) ||
        (resource.data.studentId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)) &&
         get(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)).data.studentId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (
        exists(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)) &&
        get(/databases/$(database)/documents/feedbackIdentities/$(feedbackId)).data.studentId == request.auth.uid
      );
    }

    // ─── COLLECTION: feedbackIdentities (ADMIN & STUDENT AUTHOR ONLY) ────────
    // Strictly isolates real student identity for anonymous feedback.
    // Teachers have ZERO read or write access to this collection.
    match /feedbackIdentities/{feedbackId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isStudent() &&
                       request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin() || (
        resource.data.studentId == request.auth.uid
      );
    }


    // ─── COLLECTION: semesterUpgradeRequests ─────────────────────────────────
    match /semesterUpgradeRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAdmin()
      );
      allow create: if isStudent() &&
                       request.resource.data.studentId == request.auth.uid &&
                       request.resource.data.status == 'PENDING';
      allow update, delete: if isAdmin();
    }

    // ─── COLLECTION: notifications ───────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'ALL' ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']))
      );
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── COLLECTION: notices ─────────────────────────────────────────────────
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── COLLECTION: public_routines ─────────────────────────────────────────
    match /public_routines/{routineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── COLLECTION: communicationLogs ───────────────────────────────────────
    match /communicationLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server-side Cloud Functions only
    }
  }
}
